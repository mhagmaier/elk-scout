  <wpt lat="38.279836" lon="-106.301386">
    <ele>2710.3</ele>
    <name>A3-01 TH 8892</name>
    <desc>Access point at 8,892 ft, 25% canopy, 25% slope; 0.0 mi from the nearest motorized route, 0.04 mi to Middle Creek. Imagery: road end in the Middle Creek bottom; a track continues north (check the MVUM before driving it) (satellite 2021-11-16).</desc>
    <sym>Parking Area</sym>
  </wpt>
  <wpt lat="38.252753" lon="-106.329703">
    <ele>3016.0</ele>
    <name>B3-01 E-timber 9895</name>
    <desc>East-facing knob at 9,895 ft, 37% canopy, 30% slope; 0.9 mi from the nearest motorized route, 0.26 mi to water. Imagery: poor bed: edge of an aspen clone, leafless in November; dense conifer about 250 m west (satellite 2021-11-16).</desc>
    <sym>Flag, Blue</sym>
  </wpt>
  <wpt lat="38.219136" lon="-106.361304">
    <ele>2861.8</ele>
    <name>B3-02 NE-timber 9389</name>
    <desc>Northeast-facing slope at 9,389 ft, 39% canopy, 26% slope; 0.6 mi from the nearest motorized route, 0.37 mi to water. Imagery: poor bed: west edge of a timber island of about 10 acres in open sage (satellite 2018-11-09).</desc>
    <sym>Flag, Blue</sym>
  </wpt>
  <wpt lat="38.319563" lon="-106.302783">
    <ele>2981.6</ele>
    <name>B3-03 NW-bench 9782</name>
    <desc>Northwest-facing bench at 9,782 ft, 52% canopy, 41% slope; 1.1 mi from the nearest motorized route, 0.26 mi to water. Imagery: inside dense dark timber (block T12) (satellite 2021-11-16).</desc>
    <sym>Flag, Blue</sym>
  </wpt>
