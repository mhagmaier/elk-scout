    <Folder>
      <name>1. Middle Creek</name>
      <Placemark>
        <name>A1-01 TH 8892</name>
        <description>Access point at 8,892 ft, 25% canopy, 25% slope; 0.0 mi from the nearest motorized route, 0.04 mi to Middle Creek, 0.5 mi to security timber T05 (835 ac). Photos (2021-11-16): road end in the Middle Creek bottom; a track continues north (check the MVUM before driving it). (score 0.6)</description>
        <styleUrl>#style-ACCESS</styleUrl>
        <Point>
          <coordinates>-106.301386,38.279836,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>B1-01 N-timber 10273</name>
        <description>North-facing valley at 10,273 ft, 54% canopy, 36% slope; 1.2 mi from the nearest motorized route, 1.12 mi to water, inside security timber T05 (835 ac). Photos (2021-11-16): inside dense live conifer (block T05). (score 1.0)</description>
        <styleUrl>#style-BED</styleUrl>
        <Point>
          <coordinates>-106.323676,38.279586,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
